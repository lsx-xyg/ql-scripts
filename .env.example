# ============================================
# 通用 WebDAV 配置
# 归属: common.py -> get_webdav_client()
# ============================================
# WebDAV 服务基础地址(坚果云示例)
WEBDAV_BASE_URL=https://dav.jianguoyun.com/dav
# WebDAV 账号
WEBDAV_USER=your_username
# WebDAV 密码(坚果云请用应用密码)
WEBDAV_PASS=your_password
# WebDAV 请求超时秒数,默认 60
WEBDAV_TIMEOUT=60

# ============================================
# 上传重试策略
# 归属: common.py -> webdav_upload()
# ============================================
# 上传失败重试次数,默认 3(设 0 表示只试一次)
UPLOAD_RETRY=3
# 重试基础间隔秒数,指数退避:第 n 次重试等待 基础间隔*2^(n-1),如 3,6,12,24
UPLOAD_RETRY_DELAY=3

# ============================================
# 云端备份清理策略(qinglong-backup.py / rustdesk-backup.py 共用)
# 归属: common.py -> webdav_cleanup(),脚本通过环境变量 CLEANUP_POLICY 选择
# ============================================
# count - 保留最新 N 份,其余全删,不看时间。适合固定份数备份;风险:很久没跑备份时,保留的一直是旧的
# days  - 超过 N 天直接删,不看总数。适合定时清过期;风险:脚本很久没执行时,可能一份都不剩
# both  - 超出 N 份 且 超过 N 天才删。最稳妥(默认)
# or    - 超出 N 份 或 超过 N 天就删。严格控存储上限;风险:容易误删近期想要的备份,不推荐默认使用
CLEANUP_POLICY=both
# 保留天数(days/both/or 策略使用),默认 7
RETENTION_DAYS=7
# 保留份数(count/both/or 策略使用),默认 7
RETENTION_COUNT=7

# ============================================
# qinglong-backup.py 专用
# ============================================
# 青龙数据目录
QL_DATA_DIR=/ql/data
# 备份内容别名,逗号分隔(可选值见脚本头部映射表: base,config,scripts,deps,repo,ssh.d,dep_cache,log,syslog,raw,bak,db,upload,compose)
QL_BACKUP_INCLUDE=base,config

# ============================================
# rustdesk-backup.py 专用
# ============================================
# RustDesk 数据目录(容器内挂载路径)
RUSTDESK_DIR=/source/rustdesk
